# LLM: "recorded" replays canned demo responses (no API key needed).
# For a real provider set LLM_PROVIDER to any non-"recorded" value and
# LLM_MODEL to a LiteLLM model string, e.g. <provider>/<model-name>,
# plus that provider's API key variable.
LLM_PROVIDER=recorded
# LLM_MODEL=

# Demo device
DEVICE_URL=http://localhost:8080
DEVICE_HOST=localhost
DEVICE_SSH_PORT=2222
DEVICE_USER=tester
DEVICE_PASSWORD=tester

# Optional bench lock (leave unset to run without Redis)
# REDIS_URL=redis://localhost:6379/0
