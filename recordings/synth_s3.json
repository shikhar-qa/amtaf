{
  "keyword": "then",
  "pattern": "the device config file has syslog server set to {ip} within {seconds:d} seconds",
  "function_name": "device_config_has_syslog_server",
  "params": ["device: HardwareDriver", "ip: str", "seconds: int"],
  "docstring": "Poll the device config until syslog_server equals the expected value.",
  "body": [
    "deadline = time.monotonic() + seconds",
    "actual: str | None = None",
    "while time.monotonic() < deadline:",
    "    actual = device.read_config().get(\"syslog_server\")",
    "    if actual == ip:",
    "        return",
    "    time.sleep(1)",
    "raise AssertionError(f\"syslog_server is {actual!r}, expected {ip!r}\")"
  ]
}
